# Google AI Studio → Get API key (free tier works)
GOOGLE_API_KEY=

# Supabase project → Project Settings → API. The service role key is secret:
# set it only on the server (Render), never in the website.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of sites allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000

# Optional overrides
# GEMINI_CHAT_MODEL=gemini-3.6-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# RATE_LIMIT_PER_MINUTE=8
